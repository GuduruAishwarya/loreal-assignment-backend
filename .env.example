# Use the direct PostgreSQL connection for Prisma.
# Avoid pooled Supabase URLs like ?pgbouncer=true for Prisma client connections.
DATABASE_URL="postgresql://postgres:your_supabase_password@db.your-project-id.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:your_supabase_password@db.your-project-id.supabase.co:5432/postgres"
GEMINI_API_KEY="your_gemini_api_key_here"
PORT=3001
